{
  "version": "0.2.0",
  "runtime": "ide",
  "ideation": false,
  "modelProfiles": {
    "coding-standard": { "cursor": "inherit", "copilot": "ide-session", "claude": "ide-session" },
    "review-strong": { "cursor": "inherit", "copilot": "ide-session", "claude": "ide-session" },
    "security-strong": { "cursor": "inherit", "copilot": "ide-session", "claude": "ide-session" }
  },
  "roles": {
    "lead": { "modelProfile": "coding-standard" },
    "architect": { "modelProfile": "coding-standard" },
    "engineer": { "modelProfile": "coding-standard" },
    "test-engineer": { "modelProfile": "coding-standard" },
    "security-reviewer": { "modelProfile": "security-strong" },
    "reviewer": { "modelProfile": "review-strong" },
    "scribe": { "modelProfile": "coding-standard" }
  },
  "models": {
    "note": "Hints only. The IDE session model does the work. idefactory does not launch a model.",
    "lead": "ide-session",
    "architect": "ide-session",
    "engineer": "ide-session",
    "test-engineer": "ide-session",
    "security-reviewer": "ide-session",
    "reviewer": "ide-session",
    "scribe": "ide-session"
  },
  "governance": {
    "protectedPaths": [".factory/decisions.md", ".factory/agents/"],
    "reviewerMustDiffer": true
  },
  "run": {
    "defaultMaxAgentSteps": 20,
    "defaultMaxTasks": 20,
    "defaultMaxWallClockMs": 14400000,
    "defaultMaxFailures": 5
  }
}
